{
  "info": { "name": "Example API", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "item": [
    { "name": "Health", "request": { "method": "GET", "url": "{{baseUrl}}/health" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('is up', () => pm.response.to.have.status(200));"] } }] },
    { "name": "Signed in", "request": { "method": "GET", "url": "{{baseUrl}}/me", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{apiToken}}" }] } }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('knows me', () => pm.expect(pm.response.json().name).to.eql('ann'));"] } }] }
  ]
}
